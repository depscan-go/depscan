# Copy to terraform.tfvars (gitignored) and fill in.
subscription_id = "<Azure for Students subscription id>"
location        = "<a region allowed by sys.regionrestriction>"

# The app's secrets come from Key Vault (database-url, webhook-secret, github-token).
# On a fresh setup, store them first, or switch them off here:
# wire_database_url = false
# enable_webhooks   = false
